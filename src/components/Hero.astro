---
import Button from './Button.astro';
import Heading from './Heading.astro';
import HeroVisual from './HeroVisual.astro';
---

<section id="top" class="hero">
  <HeroVisual />
  <div class="hero-fade" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <div class="hero-meta mono">
      <p>
        Experimental software company
        <br />
        Own products &amp; freelance work
      </p>
      <p class="availability">
        <i></i>Zeke &amp; rtboard are available now
      </p>
    </div>
    <div class="hero-bottom">
      <Heading hero lines={['Software', 'in motion.']} />
      <div class="hero-description">
        <p>
          Pruven is an experimental software company. We explore ideas through
          our own products and build custom software for clients.
        </p>
        <div class="button-row">
          <Button booking>Start a project</Button>
          <Button href="#work" secondary arrow={false}>
            See our products
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
