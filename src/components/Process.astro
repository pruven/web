---
import SectionLabel from './SectionLabel.astro';
import Heading from './Heading.astro';
import { processSteps } from '../data/studio';
---

<section id="process" class="section">
  <div class="wrap section-pad">
    <div class="section-head work-head">
      <div class="head-title">
        <SectionLabel number="04" text="Process" />
        <Heading lines={['From an idea', 'to working software.']} />
      </div>
      <p class="section-description reveal">
        Whether it’s an experiment of our own or a freelance client project,
        start with the problem, build a focused solution, and keep improving it.
      </p>
    </div>
    <ol class="process-grid">
      {processSteps.map((step, i) => (
        <li>
          <div class="process-rule" aria-hidden="true"></div>
          <div class="process-meta mono">
            <span>0{i + 1}</span>
            <span>{step.time}</span>
          </div>
          <h3>{step.name}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
