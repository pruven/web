---
import SectionLabel from './SectionLabel.astro';
const facts = [
  ['Our products', '2', 'Zeke and rtboard, built by Pruven.'],
  ['Our approach', 'R&D', 'Exploring ideas through experimental software.'],
  [
    'Client work',
    'Build',
    'Freelance software development for client projects.',
  ],
  [
    'Available now',
    'Try them',
    'Explore Zeke for worktrees and rtboard for ideas.',
  ],
];
---

<section id="studio" class="section studio">
  <div class="wrap section-pad">
    <div class="studio-intro">
      <SectionLabel number="01" text="The studio" />
      <p class="studio-statement reveal">
        Pruven is an experimental software company. We build our own products to
        explore ideas and build custom software for clients.{' '}
        <span>
          From Git worktrees with Zeke to an infinite canvas with rtboard, we
          build tools around ideas worth exploring.
        </span>
      </p>
    </div>
    <ul class="stats product-facts">
      {facts.map(([label, value, text]) => (
        <li>
          <div class="reveal">
            <p class="mono">{label}</p>
            <p class="stat-number">
              {value === '2' ? <span data-count="2">2</span> : value}
            </p>
            <p class="stat-description">{text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
