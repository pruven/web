---
import Halftone from './Halftone.astro';
import portrait from '../assets/portrait.jpg';
---

<section
  id="testimonial"
  class="section testimonial"
  aria-label="Client testimonial"
>
  <div class="wrap testimonial-inner">
    <div class="testimonial-image">
      <Halftone
        src={portrait}
        alt="Portrait accompanying the client testimonial"
        position="50% 20%"
        portrait
      />
    </div>
    <figure class="reveal">
      <span class="quote-mark" aria-hidden="true">
        “
      </span>
      <blockquote>
        <p>
          Pruven rebuilt our mobile banking app in fourteen weeks without a
          single hour of downtime. Our rating went from 3.1 to 4.8 and support
          calls dropped by a third.
        </p>
      </blockquote>
      <figcaption>
        <i aria-hidden="true"></i>
        <span>Giulia Ferraro</span>
        <span class="mono">Chief Digital Officer, Marea Bank</span>
      </figcaption>
    </figure>
  </div>
</section>
