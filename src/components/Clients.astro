---
import {
  Zap,
  WavesHorizontal,
  HeartPulse,
  Compass,
  Sun,
  Sprout,
  Castle,
  Ship,
} from '@lucide/astro';
const clients = [
  { name: 'Vela Energy', icon: Zap },
  { name: 'Marea Bank', icon: WavesHorizontal },
  { name: 'Arcadia Health', icon: HeartPulse },
  { name: 'Polaris Mobility', icon: Compass },
  { name: 'Lumera', icon: Sun },
  { name: 'Orto Foods', icon: Sprout },
  { name: 'Castello Group', icon: Castle },
  { name: 'Nordico Freight', icon: Ship },
];
---

<section id="clients" class="clients" aria-label="Clients">
  <div class="wrap clients-inner">
    <p class="mono">Trusted by teams at</p>
    <div class="marquee" tabindex="0" aria-label="Client names; focus to pause">
      <ul>
        {[0, 1].map((copy) =>
          clients.map(({ name, icon: Icon }) => (
            <li aria-hidden={copy === 1 ? 'true' : undefined}>
              <Icon size={20} />
              <span>{name}</span>
            </li>
          )),
        )}
      </ul>
    </div>
  </div>
</section>
