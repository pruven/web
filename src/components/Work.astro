---
import SectionLabel from './SectionLabel.astro';
import Heading from './Heading.astro';
import Tags from './Tags.astro';
import Halftone from './Halftone.astro';
import { ArrowRight } from '@lucide/astro';
import polaris from '../assets/polaris.jpg';
import marea from '../assets/marea.jpg';
import arcadia from '../assets/arcadia.jpg';
import vela from '../assets/vela.jpg';
const projects = [
  {
    client: 'Polaris Mobility',
    sector: 'Mobility',
    year: '2025',
    title: 'A real-time fleet platform tracking 18,000 vehicles across Europe',
    metric: '−38%',
    outcome: 'Empty kilometres',
    tags: ['Cloud', 'Data', 'Web app'],
    image: polaris,
    alt: 'Aerial view of green fields and a winding landscape',
    position: '50% 42%',
  },
  {
    client: 'Marea Bank',
    sector: 'Fintech',
    year: '2026',
    title: 'A mobile banking app rebuilt for 1.2 million customers',
    metric: '4.8',
    outcome: 'App Store rating',
    tags: ['iOS', 'Android', 'Design system'],
    image: marea,
    alt: 'A smartphone displaying a mobile app',
  },
  {
    client: 'Arcadia Health',
    sector: 'Healthcare',
    year: '2025',
    title: 'Online booking for a network of 64 clinics',
    metric: '90s',
    outcome: 'Average booking time',
    tags: ['Product design', 'Web', 'Integrations'],
    image: arcadia,
    alt: 'A clinician at work',
    position: '50% 28%',
  },
  {
    client: 'Vela Energy',
    sector: 'Energy',
    year: '2024',
    title: 'Machine learning forecasts for 2.4 GW of wind capacity',
    metric: '−27%',
    outcome: 'Forecast error',
    tags: ['Data and AI', 'Forecasting', 'Dashboards'],
    image: vela,
    alt: 'Wind turbines generating renewable energy',
    position: '50% 30%',
  },
];
---

<section id="work" class="section">
  <div class="wrap section-pad">
    <div class="section-head work-head">
      <div class="head-title">
        <SectionLabel number="03" text="Selected work" />
        <Heading lines={['Recent work,', 'measured in outcomes.']} />
      </div>
      <div class="section-description reveal">
        <p>
          A few of the products we designed, built and still run with our
          clients. Hover a project to see the original photo behind the dots.
        </p>
        <a href="#contact" class="case-link mono">
          Request full case studies <ArrowRight size={16} />
        </a>
      </div>
    </div>
    <div class="work-grid">
      {projects.map((project, i) => (
        <article class:list={['project', `project-${i + 1}`]}>
          <div class="project-visual">
            <Halftone
              src={project.image}
              alt={project.alt}
              position={project.position}
            />
            <span class="project-year mono">{project.year}</span>
          </div>
          <div class="project-info">
            <div>
              <p class="mono project-client">
                {project.client}
                <span>/</span>
                {project.sector}
              </p>
              <h3>{project.title}</h3>
            </div>
            <p class="project-metric">
              <strong>{project.metric}</strong>
              <span class="mono">{project.outcome}</span>
            </p>
          </div>
          <Tags tags={project.tags} />
        </article>
      ))}
    </div>
  </div>
</section>
