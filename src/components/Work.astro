---
import SectionLabel from './SectionLabel.astro';
import Heading from './Heading.astro';
import Tags from './Tags.astro';
import Button from './Button.astro';
import { Copy, ArrowUpRight } from '@lucide/astro';
import RTBoardProduct from './RTBoardProduct.astro';
import { product } from '../data/product';
---

<section id="work" class="section">
  <div class="wrap section-pad">
    <div class="section-head work-head">
      <div class="head-title">
        <SectionLabel number="03" text="Our products" />
        <Heading lines={['Small tools.', 'Less friction.']} />
      </div>
      <p class="section-description reveal">
        Our experiments become tools you can use. Zeke handles environment files
        for Git worktrees. rtboard gives your ideas an infinite canvas.
      </p>
    </div>
    <article class="zeke-product" aria-labelledby="zeke-title">
      <div
        class="zeke-terminal"
        aria-label="Zeke installation and example output"
      >
        <div class="terminal-bar">
          <span class="terminal-dots" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>zeke / terminal</span>
          <button
            type="button"
            class="copy-install"
            data-copy-install
            aria-label="Copy Zeke installation commands"
          >
            <Copy size={16} />
            <span>Copy install</span>
          </button>
        </div>
        <div class="terminal-content">
          <p class="terminal-comment"># Add Zeke to your project</p>
          <pre><code><span class="terminal-prompt">$</span> bun add --dev @pruven/zeke
<span class="terminal-prompt">$</span> bun --bun zeke install</code></pre>
          <p class="terminal-comment"># Create your next worktree</p>
          <pre><code><span class="terminal-prompt">$</span> git worktree add ../my-feature -b my-feature</code></pre>
          <div class="terminal-output">
            <p>
              <span>zeke:</span> copied ".env"
            </p>
            <p>
              <span>zeke:</span> copied "apps/api/.env.local"
            </p>
          </div>
          <p class="terminal-result">
            <i aria-hidden="true"></i>Environment files, ready to go.
          </p>
        </div>
        <p
          class="copy-status"
          role="status"
          aria-live="polite"
          data-copy-status
        ></p>
      </div>
      <div class="zeke-copy">
        <p class="mono">Pruven / Developer tools</p>
        <h3 id="zeke-title">{product.name}</h3>
        <p class="zeke-tagline">
          Environment files.
          <br />
          In every worktree.
        </p>
        <p class="zeke-description">{product.description}</p>
        <Tags tags={product.tags} />
        <ul class="zeke-features">
          <li>Copies missing files without overwriting existing ones</li>
          <li>Preserves nested folders</li>
          <li>Logs filenames, never file contents</li>
        </ul>
        <Button href={product.url}>View Zeke</Button>
        <a class="zeke-docs mono" href={product.url}>
          Installation and documentation <ArrowUpRight size={14} />
        </a>
      </div>
    </article>
    <RTBoardProduct />
  </div>
</section>
