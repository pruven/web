---
import VisualFrame from './VisualFrame.astro';
interface Props {
  kind: 'micro-slats' | 'pattern-waves' | 'ghost-fibers' | 'crt-warp';
  id: string;
  label: string;
}
const { kind, id, label } = Astro.props;
const wave = Array.from({ length: 19 }, (_, i) => {
  const y = 30 + i * 8;
  return `M-100 ${y} C0 ${y - 88} 65 ${y + 88} 160 ${y} S320 ${y - 88} 420 ${y}`;
});
const fibers = Array.from({ length: 38 }, (_, i) => {
  const y = 42 + i * 3.5;
  return `M-45 ${y + Math.sin(i * 0.5) * 15} C65 ${y - 90} 103 ${200 - y} 170 ${y - 5} S290 ${y + 75} 370 ${y - 10}`;
});
const grid = Array.from({ length: 13 }, (_, i) => {
  const x = 16 + i * 24;
  const bend = (x - 160) * 0.24;
  return `M${x} -15 Q${x + bend} 104 ${x} 223`;
});
---

<VisualFrame
  id={id}
  label={label}
  class={`service-illustration visual-${kind}`}
>
  <div
    class="service-effect"
    data-service-effect={kind}
    data-effect-status="fallback"
  >
    <svg viewBox="0 0 320 208" fill="none" aria-hidden="true">
      <defs>
        <linearGradient
          id={`${id}-ink`}
          x1="0"
          y1="0"
          x2="320"
          y2="208"
          gradientUnits="userSpaceOnUse"
        >
          <stop stop-color="#315efb" />
          <stop offset="0.55" stop-color="#93c5fd" />
          <stop offset="1" stop-color="#38bdf8" />
        </linearGradient>
        <radialGradient id={`${id}-wash`}>
          <stop stop-color="#b9d7ff" stop-opacity="0.65" />
          <stop offset="1" stop-color="#eaf2ff" stop-opacity="0" />
        </radialGradient>
        <linearGradient
          id={`${id}-fiber`}
          x1="0"
          y1="0"
          x2="320"
          y2="0"
          gradientUnits="userSpaceOnUse"
        >
          <stop stop-color="#385b96" stop-opacity="0" />
          <stop offset="0.3" stop-color="#86aef6" stop-opacity="0.35" />
          <stop offset="0.6" stop-color="#d5efff" />
          <stop offset="1" stop-color="#507bb8" stop-opacity="0" />
        </linearGradient>
        <linearGradient id={`${id}-scan`} x1="0" y1="0" x2="0" y2="1">
          <stop stop-color="#86caff" stop-opacity="0" />
          <stop offset="1" stop-color="#86caff" stop-opacity="0.18" />
        </linearGradient>
      </defs>
      {kind === 'micro-slats' && (
        <>
          <rect width="320" height="208" fill="#edf3ff" />
          {Array.from({ length: 21 }, (_, x) =>
            Array.from({ length: 9 }, (_, y) => {
              const strength =
                0.25 + 0.75 * (0.5 + 0.5 * Math.sin(x * 0.3 + y * 0.7));
              return (
                <rect
                  x={8 + x * 15}
                  y={8 + y * 23}
                  width="5"
                  height={8 + strength * 12}
                  rx="2.5"
                  fill="#315efb"
                  opacity={strength}
                />
              );
            }),
          )}
        </>
      )}
      {kind === 'pattern-waves' && (
        <>
          <ellipse
            cx="182"
            cy="104"
            rx="175"
            ry="120"
            fill={`url(#${id}-wash)`}
          />
          <g
            class="pattern-wave-field"
            stroke={`url(#${id}-ink)`}
            stroke-width="1.25"
          >
            {wave.map((d, i) => (
              <path
                class="pattern-wave"
                d={d}
                style={`--i:${i}`}
                opacity={0.3 + Math.sin((i / 19) * Math.PI) * 0.6}
              />
            ))}
          </g>
        </>
      )}
      {kind === 'ghost-fibers' && (
        <>
          <rect width="320" height="208" fill="#101e32" />
          <ellipse
            cx="175"
            cy="110"
            rx="160"
            ry="95"
            fill={`url(#${id}-wash)`}
            opacity="0.13"
          />
          <g
            class="ghost-fiber-field"
            stroke={`url(#${id}-fiber)`}
            stroke-width="0.7"
          >
            {fibers.map((d, i) => (
              <path
                class="ghost-fiber"
                d={d}
                style={`--i:${i}`}
                opacity={0.2 + (i % 7) * 0.1}
              />
            ))}
          </g>
        </>
      )}
      {kind === 'crt-warp' && (
        <>
          <rect width="320" height="208" fill="#111f34" />
          <g
            class="crt-grid"
            stroke="#6399e8"
            stroke-width="0.7"
            opacity="0.55"
          >
            {grid.map((d) => (
              <path d={d} />
            ))}
            {Array.from({ length: 10 }, (_, i) => {
              const y = 5 + i * 22;
              return (
                <path d={`M-10 ${y} Q160 ${y + (y - 104) * 0.36} 330 ${y}`} />
              );
            })}
          </g>
          <g class="crt-signal" stroke="#b4d8ff" stroke-width="1.5">
            <path d="M107 90L91 104L107 118M213 90L229 104L213 118M173 82L148 126" />
            <path
              d="M78 69H91M78 69V82M242 69H229M242 69V82M78 139H91M78 139V126M242 139H229M242 139V126"
              stroke-opacity="0.5"
            />
          </g>
          <g stroke="#070e19" stroke-width="1" opacity="0.36">
            {Array.from({ length: 52 }, (_, i) => (
              <path d={`M0 ${i * 4}H320`} />
            ))}
          </g>
          <rect
            class="crt-scan"
            y="-60"
            width="320"
            height="60"
            fill={`url(#${id}-scan)`}
          />
        </>
      )}
    </svg>
    {kind === 'ghost-fibers' && <canvas aria-hidden="true"></canvas>}
  </div>
</VisualFrame>
