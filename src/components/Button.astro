---
import { ArrowUpRight } from '@lucide/astro';
interface Props {
  href?: string;
  booking?: boolean;
  secondary?: boolean;
  small?: boolean;
  arrow?: boolean;
  class?: string;
}
const {
  href = '/contact',
  booking = false,
  secondary = false,
  small = false,
  arrow = true,
  class: cls,
} = Astro.props;
---

<a
  href={booking ? 'https://cal.com/lossstheaven/15min' : href}
  data-booking-trigger={booking || undefined}
  aria-haspopup={booking ? 'dialog' : undefined}
  class:list={[
    'button',
    { 'button-secondary': secondary, 'button-small': small },
    cls,
  ]}
>
  <slot />
  {arrow && <ArrowUpRight size={16} />}
</a>
