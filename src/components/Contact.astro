---
import SectionLabel from './SectionLabel.astro';
import Heading from './Heading.astro';
import Button from './Button.astro';
import { CalendarDays, ArrowUpRight } from '@lucide/astro';
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<section id="contact" class="section">
  <div class="wrap section-pad contact-grid">
    <div class="contact-copy">
      <SectionLabel number="05" text="Contact" />
      <Heading
        contact
        as={standalone ? 'h1' : 'h2'}
        lines={['Let’s build', 'what’s next.']}
      />
      <p class="contact-description">
        Have a project in mind? Let’s talk about what you need built. You can
        also get in touch about Zeke, rtboard or our software experiments.
      </p>
    </div>
    <div class="contact-booking">
      <CalendarDays size={28} aria-hidden="true" />
      <h3>Start with a conversation.</h3>
      <p>
        Choose a time to talk about your project, our products, or an idea
        you’re exploring.
      </p>
      <div class="button-row">
        <Button booking>Start a project</Button>
        <a
          class="button button-secondary"
          href="https://cal.com/lossstheaven/hello"
          data-booking-trigger="hello"
          aria-haspopup="dialog"
        >
          Say hello <ArrowUpRight size={16} />
        </a>
      </div>
      <p class="mono contact-booking-note">Book a time through Cal.com</p>
    </div>
  </div>
</section>
