---
import SectionLabel from './SectionLabel.astro';
import Heading from './Heading.astro';
import Tags from './Tags.astro';
import { services } from '../data/studio';
---

<section id="services" class="section">
  <div class="wrap section-pad">
    <div class="section-head">
      <div class="head-title">
        <SectionLabel number="02" text="Services" />
        <Heading lines={['Your idea.', 'Built together.']} />
      </div>
      <p class="section-description reveal">
        We take on freelance software projects for clients. From design and
        development to deployment, the work starts with what you need to build.
      </p>
    </div>
    <ul class="services-grid">
      {services.map((service, i) => (
        <li class="service-card">
          <div class="service-visual">
            <canvas data-art={service.art} aria-hidden="true"></canvas>
            <span class="mono">0{i + 1}</span>
          </div>
          <div class="service-body">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <Tags tags={service.tags} />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
