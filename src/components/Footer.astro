---
import { products } from '../data/product';
import Logo from './Logo.astro';
import { ArrowUp } from '@lucide/astro';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo />
        <p>
          An experimental software company building its own products and taking
          on freelance projects for clients.
        </p>
      </div>
      <nav aria-label="Footer">
        <p class="mono">Sitemap</p>
        <ul>
          {['Products', 'Services', 'Process', 'Studio', 'Contact'].map(
            (link) => (
              <li>
                <a
                  href={
                    link === 'Contact'
                      ? '/contact'
                      : `/#${link === 'Products' ? 'work' : link.toLowerCase()}`
                  }
                >
                  {link}
                </a>
              </li>
            ),
          )}
        </ul>
      </nav>
      <div>
        <p class="mono">Products</p>
        <ul>
          {products.map((product) => (
            <li>
              <a href={product.url}>{product.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="mono">Say hello</p>
        <ul>
          <li>
            <a
              href="https://cal.com/lossstheaven/hello"
              data-booking-trigger="hello"
              aria-haspopup="dialog"
            >
              Say hello
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-art">
      <svg class="footer-wordmark" viewBox="0 0 1200 400" aria-hidden="true">
        <text x="0" y="300" textLength="1195" lengthAdjust="spacingAndGlyphs">
          pruven
        </text>
      </svg>
    </div>
    <div class="footer-legal mono">
      <p>© {new Date().getFullYear()} Pruven</p>
      <p>Experiments &amp; client work</p>
      <a href="/#top">
        Back to top <ArrowUp size={14} />
      </a>
    </div>
  </div>
</footer>
