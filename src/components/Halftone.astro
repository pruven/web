---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  position?: string;
  portrait?: boolean;
}
const { src, alt, position = '50% 50%', portrait = false } = Astro.props;
---

<div
  class:list={['halftone', { portrait: portrait }]}
  tabindex="0"
  role="button"
  aria-pressed="false"
  aria-label={`${alt}. Hover, focus, or tap to reveal photograph.`}
  style={`--image-position:${position}`}
>
  <Image
    src={src}
    alt={alt}
    widths={[400, 800, 1200, 1600]}
    sizes={
      portrait
        ? '(min-width:640px) 22rem, calc(100vw - 40px)'
        : '(min-width:1024px) 58vw, 100vw'
    }
    loading="lazy"
    format="webp"
  />
  <canvas data-halftone aria-hidden="true"></canvas>
</div>
