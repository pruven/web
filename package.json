{
  "name": "pruven-studio",
  "version": "1.0.0",
  "description": "An independent Astro recreation of the Onda Studio reference",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "playwright test",
    "test:visual": "bun scripts/capture.mjs",
    "format": "prettier --write src scripts tests astro.config.mjs playwright.config.ts",
    "format:check": "prettier --check src scripts tests astro.config.mjs playwright.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@lucide/astro": "^1.73.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "gsap": "^3.15.1",
    "motion": "^14.14.0",
    "ogl": "^1.0.11",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "private": true
}
